<odoo>
    <record model="ir.ui.view" id="online_bank_statement_provider_form">
        <field name="name">online.bank.statement.provider.form</field>
        <field name="model">online.bank.statement.provider</field>
        <field
            name="inherit_id"
            ref="account_statement_import_online.online_bank_statement_provider_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main']" position="inside">
                <group name="moss" string="Moss" invisible="service != 'moss'">
                    <field name="username" string="Key ID" />
                    <field name="password" string="Secret Key" password="True" />
                    <field
                        name="api_base"
                        string="API Base URL"
                        placeholder="https://public-api.getmoss.com"
                        groups="base.group_no_one"
                    />
                    <field name="moss_date_margin" />
                    <field name="moss_token_expiration" groups="base.group_no_one" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
